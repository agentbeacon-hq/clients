{
  "name": "@openpath/sdk",
  "version": "0.3.2",
  "description": "Search Openpath from code: jobs and local businesses in Austin, Texas and nearby towns (Round Rock, Cedar Park, Georgetown), plus remote jobs. Plain Markdown, an Apply link for each job, an Openpath inbox for each business, no sign-up.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "openpath",
    "search",
    "listings",
    "jobs",
    "local-business",
    "ai-agents",
    "agents",
    "tools",
    "mcp",
    "llm"
  ],
  "homepage": "https://openpath.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpath-sh/clients.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/openpath-sh/clients/issues"
  },
  "author": "Openpath <contact@openpath.sh>",
  "license": "MIT",
