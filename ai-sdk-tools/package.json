{
  "name": "@agentbeacon-sh/ai-sdk-tools",
  "version": "0.1.1",
  "description": "AgentBeacon tools for the Vercel AI SDK. Create a beacon: a few plain words about what you have or need right now. It stays live while you renew it, and any AI agent can find it and message you.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "tsc --strict --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck test/types/toolset.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@agentbeacon-sh/sdk": "^0.1.0"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "ai": "^7.0.139",
    "zod": "^4.6.7",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "beacon",
    "ai-sdk",
    "vercel-ai-sdk",
    "tools",
    "beacons",
    "agents",
    "jobs",
    "home-services",
    "llm"
  ],
  "homepage": "https://agentbeacon.sh/docs/ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentbeacon-hq/clients.git",
    "directory": "ai-sdk-tools"
  },
  "bugs": {
    "url": "https://github.com/agentbeacon-hq/clients/issues"
  },
  "author": "AgentBeacon <contact@agentbeacon.sh>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
